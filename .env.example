# ==============================================================================
# Shiggaon Watershed Intelligence System — Environment Configuration Template
# Copy this file to '.env' and populate with your local / production secrets.
# IMPORTANT: Never commit '.env' to version control (.gitignore covers .env).
# ==============================================================================

# PostgreSQL + PostGIS Connection Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jaldrishti

# Direct Database URL (Optional: takes precedence if set, e.g. for Supabase / Neon / RDS)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# Auto-sync authoritative micro-watersheds on API startup (default: false)
DB_AUTO_SYNC_ON_STARTUP=false
