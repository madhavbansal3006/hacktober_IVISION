# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# OS junk
.DS_Store
Thumbs.db

# Generated pipeline outputs -- regenerated by running the pipeline,
# not source. See README for what creates these.
/outputs/
/12_GEO_CODED_IMAGES/
/data/uploads/

# Synthetic test fixtures -- regenerated automatically at the start of
# every pytest run (tests/conftest.py), not source.
/tests/fixtures/

# Editor/IDE
.vscode/
.idea/
*.swp

# Secrets -- none should ever exist in this repo, but guard against
# accidental commits.
.env
*.pem
*.key
